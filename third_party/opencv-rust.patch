 	pub fn probe() -> Result<Self> {
+		// qqcode patch: use the OpenCV built by `opencv-vendored` and nothing else. Going through `probe_system()`
+		// would fall back to a system-wide OpenCV whenever the vendored one can't be used.
+		if let Ok(include_paths) = env::var("DEP_OPENCV_VENDORED_INCLUDE") {
+			let link_paths = env::var("DEP_OPENCV_VENDORED_LIB")?;
+			let link_libs = env::var("DEP_OPENCV_VENDORED_LIBS")?;
+			return Self::probe_from_paths(
+				Some(EnvList::from(include_paths.as_str())),
+				Some(EnvList::from(link_paths.as_str())),
+				Some(EnvList::from(link_libs.as_str())),
+			);
+		}
 		let include_paths = env::var("OPENCV_INCLUDE_PATHS").ok();
 		let include_paths = include_paths.as_deref().map(EnvList::from);
 		let link_paths = env::var("OPENCV_LINK_PATHS").ok();
